# Kopier denne fila til .env og fyll inn nøkkelen:
#
#     cp .env.example .env          (Windows: copy .env.example .env)
#
# .env er gitignorert. .env.example er det ikke — så ALDRI skriv en ekte
# nøkkel her.
#
# Ingenting under er påkrevd. Uten .env i det hele tatt virker hele det
# deterministiske laget: uttrekk, avstemming, grafer, HAZOP-ark,
# regelscreening, kontrollrom-brief og alle sammenligningssidene.


# ---------------------------------------------------------------------------
# AI-laget (valgfritt) — én nøkkel dekker alt
# ---------------------------------------------------------------------------
# Gratis nøkkel fra Google AI Studio: https://aistudio.google.com/apikey
# Krever en Google-konto. Gratis-tieren holdt til all utvikling og demo i
# dette prosjektet, inkludert vision-lesing av hele tegningsbunken.
GEMINI_API_KEY=

# Modellvalg. Utelat linja for prosjektets standard (gemini-3.1-flash-lite,
# definert i src/ai/gemini_client.py). Grunnen til at dette er en variabel og
# ikke en konstant: modellgenerasjoner avvikles på uker-til-måneder, og det
# skjedde midt i prosjektperioden. Bytter du modell, kjør
# src/validate_against_dexpi.py etterpå og se at tallene holder.
# GEMINI_MODEL=gemini-3.1-flash-lite

# Kun for et alternativt operatør-brief/systemsammendrag. Uten den brukes den
# deterministiske malen, som er kilden til sannhet uansett.
# Krever `uv sync --extra anthropic`.
# ANTHROPIC_API_KEY=


# ---------------------------------------------------------------------------
# Brytere (valgfritt)
# ---------------------------------------------------------------------------
# Slå på vision-reserven i tag-uttrekket. Utløses kun på tag-fattige
# tegninger (< 3 tekst-tags) og caches til reports/vision_cache/tags/.
# HULDRA_VISION=1

# Omgå diskcachen og tving nye API-kall. Bruker kvote — la den stå av til
# du faktisk vil ha et nytt svar.
# HULDRA_VISION_FRESH=1

# Hopp over alle NeqSim-kall. Nyttig hvis du ikke har Java installert.
# HULDRA_NO_NEQSIM=1
